APP_NAME="HealthHub Hospital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ================= DATABASE =================
# Default: SQLite (nol konfigurasi, cocok untuk localhost/demo).
# File database: database/database.sqlite  (buat dulu: `touch database/database.sqlite`
# atau jawab "yes" saat perintah `php artisan migrate` menawarkan membuat file).
DB_CONNECTION=sqlite

# --- PostgreSQL (sesuai blueprint produksi) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=app_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# --- MySQL / MariaDB ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=app_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
FRONTEND_URL=http://localhost:8000

# Mock Payment Gateway (demo)
PAYMENT_GATEWAY_DRIVER=mock
